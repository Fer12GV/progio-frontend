# =============================================================================
# PROGIO Frontend — variables de entorno (ejemplo)
# Copiar a `.env` y ajustar. Todo lo que consuma el código debe ser VITE_*.
# =============================================================================

# URL pública del backend (mismo host/puerto que NGINX_HTTP_PORT del backend).
VITE_API_BASE_URL=http://localhost:9001

# Prefijo versionado de la API (debe coincidir con API_PREFIX del backend).
VITE_API_PREFIX=/api/v1

# Puerto del dev server de Vite (opcional; por defecto 3300 en vite.config.js).
FRONTEND_PORT=3300

# Correo con el que inicias sesión (mismo valor que EMAIL_USERNAME completo del backend si usas correo completo).
# No pongas contraseñas en VITE_* (el bundle es público).
VITE_LOGIN_EMAIL=admin.general@example.com

# Dominio de los otros cuatro usuarios seed (mismo valor que SEED_EMAIL_DOMAIN del backend).
VITE_SEED_EMAIL_DOMAIN=example.com

# Docker build: las mismas VITE_* deben inyectarse en build time (docker compose
# build.args o docker build --build-arg). Ver Dockerfile y docs/DEPLOYMENT.md.
